---

<Layout title={pageTitle} currentPath="/new-games">

    <!-- Preview Notice Header -->
    <aside class="preview-banner" aria-label="Version preview switcher">
        <div class="preview-inner">
            <div class="preview-badge">
                <span class="sparkle">✨</span>
                <strong>NEW GAMES PORTFOLIO PREVIEW</strong>
            </div>
            <p class="preview-text">
                Revamped layout aligned with the new home design: ambient dark hero, filterable cards, and deep-dive case studies.
            </p>
            <div class="preview-actions">
                <a href="/games" class="preview-link">Go to Live Games Portfolio (/games) &rarr;</a>
            </div>
        </div>
    </aside>

    <!-- Top Ambient Hero Banner -->
    <header class="games-hero">
        <div class="ambient-glow glow-1" aria-hidden="true"></div>
        <div class="ambient-glow glow-2" aria-hidden="true"></div>
        <div class="grid-overlay" aria-hidden="true"></div>

        <div class="hero-container">
            <div class="status-pill">
                <span class="status-dot"></span>
                <span>Producer · LiveOps Lead · Analytics Director</span>
            </div>

            <h1 class="hero-title">
                Games I Helped <span class="gradient-text">Bring to Life</span>
            </h1>

            <p class="hero-subtitle">
                A track record of shipping, operating, and scaling commercial mobile games. From global franchise powerhouses like <strong>Tetris®</strong>, <strong>Star Wars™</strong>, and <strong>NBA Clash</strong> to tactical RPGs and strategy titles, my focus is driving player retention, balanced economies, and revenue growth.
            </p>

            <!-- Metrics Ribbon -->
            <div class="stats-ribbon">
                {gameStats.map(stat => (
                    <div class="stat-card">
                        <div class="stat-number">{stat.value}</div>
                        <div class="stat-label">{stat.label}</div>
                        <div class="stat-subtext">{stat.subtext}</div>
                    </div>
                ))}
            </div>
        </div>
    </header>

    <!-- Filter Bar & Portfolio Showcase -->
    <main class="portfolio-section" id="portfolio-grid">
        <div class="container">
            
            <!-- Filter Toolbar -->
            <div class="filter-toolbar">
                <div class="filter-label-group">
                    <span class="filter-heading">Filter Projects:</span>
                    <span class="game-count-badge" id="visible-count">{games.length} Games</span>
                </div>
                
                <div class="filter-buttons" role="tablist" aria-label="Game categories">
                    <button class="filter-btn active" data-filter="all">All Games</button>
                    <button class="filter-btn" data-filter="playstudios">Playstudios</button>
                    <button class="filter-btn" data-filter="globant">Globant</button>
                    <button class="filter-btn" data-filter="dena">DeNA</button>
                    <button class="filter-btn" data-filter="rpg">RPGs</button>
                    <button class="filter-btn" data-filter="sports">Sports</button>
                    <button class="filter-btn" data-filter="strategy">Strategy</button>
                </div>
            </div>

            <!-- Games Grid -->
            <div class="games-grid">
                {games.map((game, index) => (
                    <article 
                        class="game-card" 
                        id={game.id}
                        data-studio={game.studioKey}
                        data-category={game.category}
                    >
                        <!-- Media Container with Gallery Preview -->
                        <div class="game-media-container">
                            <div class="media-carousel" data-card-id={game.id}>
                                {game.images.map((img, imgIdx) => (
                                    <div class={`media-slide ${imgIdx === 0 ? 'active' : ''}`} data-index={imgIdx}>
                                        <img 
                                            src={img.src} 
                                            alt={img.alt} 
                                            class="slide-img" 
                                            loading={index > 1 ? "lazy" : "eager"}
                                        />
                                    </div>
                                ))}
                            </div>

                            <!-- Highlight Metric Badge -->
                            <div class="card-highlight-pill">
                                <span>{game.highlightTag}</span>
                            </div>

                            <!-- Carousel dots when more than 1 image -->
                            {game.images.length > 1 && (
                                <div class="gallery-dots" data-card-id={game.id}>
                                    {game.images.map((_, i) => (
                                        <button 
                                            class={`dot-btn ${i === 0 ? 'active' : ''}`} 
                                            data-slide={i} 
                                            aria-label={`Show image ${i + 1}`}
                                        ></button>
                                    ))}
                                </div>
                            )}
                        </div>

                        <!-- Card Body Content -->
                        <div class="game-body">
                            <!-- Floating Game Icon (Placed here so overflow:hidden never cuts it in half) -->
                            <div class="icon-avatar-wrap">
                                <img src={game.icon} alt={`${game.title} icon`} class="avatar-icon" />
                            </div>
                            
                            <div class="game-meta-row">
                                <div class="studio-badge-group">
                                    <span class="studio-tag">{game.studio}</span>
                                    <span class="genre-text">{game.genre}</span>
                                </div>
                                <span class="period-pill">{game.period}</span>
                            </div>

                            <h2 class="game-title">{game.title}</h2>
                            <p class="game-role-badge">
                                <span class="role-icon">⚡</span>
                                <span>{game.role}</span>
                            </p>

                            <!-- Contributions List -->
                            <div class="contributions-block">
                                <h3 class="section-micro-title">Key Contributions & Impact</h3>
                                <ul class="contributions-list">
                                    {game.contributions.map(item => (
                                        <li>
                                            <span class="bullet-check">✓</span>
                                            <span>{item}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>

                            <!-- Tech Stack & System Tags -->
                            <div class="card-bottom-row">
                                <div class="tags-container">
                                    {game.techStack.map(tag => (
                                        <span class="system-tag">{tag}</span>
                                    ))}
                                </div>

                                {game.link && (
                                    <a 
                                        href={game.link} 
                                        target="_blank" 
                                        rel="noopener noreferrer" 
                                        class="external-action-btn"
                                    >
                                        <span>{game.linkLabel || "View Project"}</span>
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                            <polyline points="15 3 21 3 21 9"></polyline>
                                            <line x1="10" y1="14" x2="21" y2="3"></line>
                                        </svg>
                                    </a>
                                )}
                            </div>

                        </div>
                    </article>
                ))}
            </div>

            <div class="no-results-msg" id="no-results" style="display: none;">
                <p>No games found for this category filter. Try selecting "All Games".</p>
            </div>

        </div>
    </main>

    <!-- Bottom Contact CTA Banner -->
    <section class="section games-cta-section">
        <div class="container">
            <div class="cta-banner-glass">
                <div class="cta-text-wrap">
                    <span class="cta-mini-tag">Opportunities & Advisory</span>
                    <h2 class="cta-heading">Looking to elevate your game's LiveOps or roadmap?</h2>
                    <p class="cta-sub">
                        From economy redesign and content cadence to setting up high-conversion A/B testing pipelines, I bring 15+ years of software & gaming leadership.
                    </p>
                </div>
                <div class="cta-button-group">
                    <a href={`mailto:${siteConfig.email}`} class="btn-primary-solid">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                        <span>Send Email</span>
                    </a>
                    <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="btn-secondary-glass">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64c-.95 0-1.68.74-1.68 1.69a1.69 1.69 0 0 0 1.68 1.69c.96 0 1.69-.75 1.69-1.69 0-.95-.73-1.69-1.69-1.69Z"/>
                        </svg>
                        <span>LinkedIn Profile</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

</Layout>

<script>
    // Client-side category filtering
    const filterButtons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.game-card');
    const countBadge = document.getElementById('visible-count');
    const noResults = document.getElementById('no-results');

    filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            filterButtons.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const filter = btn.getAttribute('data-filter');
            let visible = 0;

            cards.forEach(card => {
                const studio = card.getAttribute('data-studio');
                const category = card.getAttribute('data-category');

                if (filter === 'all' || studio === filter || category === filter) {
                    (card as HTMLElement).style.display = 'flex';
                    visible++;
                } else {
                    (card as HTMLElement).style.display = 'none';
                }
            });

            if (countBadge) {
                countBadge.textContent = `${visible} Game${visible === 1 ? '' : 's'}`;
            }

            if (noResults) {
                noResults.style.display = visible === 0 ? 'block' : 'none';
            }
        });
    });

    // Image dot switcher for cards with multiple screenshots
    document.querySelectorAll('.game-card').forEach(card => {
        const dots = card.querySelectorAll('.dot-btn');
        const slides = card.querySelectorAll('.media-slide');

        dots.forEach(dot => {
            dot.addEventListener('click', (e) => {
                e.stopPropagation();
                const targetIdx = parseInt(dot.getAttribute('data-slide') || '0', 10);
                
                dots.forEach(d => d.classList.remove('active'));
                dot.classList.add('active');

                slides.forEach((s, idx) => {
                    s.classList.toggle('active', idx === targetIdx);
                });
            });
        });
    });
</script>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

    :global(body) {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        color: #1e293b;
        background-color: #f8fafc;
    }

    /* Comparison Preview Banner */
    .preview-banner {
        background: linear-gradient(90deg, #1e1b4b 0%, #312e81 100%);
        color: #e0e7ff;
        padding: 0.65rem 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    }

    .preview-inner {
        max-width: 1240px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        font-size: 0.85rem;
    }

    .preview-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(99, 102, 241, 0.35);
        padding: 0.25rem 0.65rem;
        border-radius: 6px;
        letter-spacing: 0.04em;
        font-size: 0.78rem;
        color: #c7d2fe;
        border: 1px solid rgba(165, 180, 252, 0.3);
    }

    .preview-text {
        color: #cbd5e1;
        margin: 0;
    }

    .preview-link {
        display: inline-flex;
        align-items: center;
        color: #ffffff;
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 4px;
        transition: color 0.2s;
    }

    .preview-link:hover {
        color: #93c5fd;
    }

    /* Games Hero Banner */
    .games-hero {
        position: relative;
        background: radial-gradient(circle at 15% 20%, #1e1b4b 0%, #0f172a 60%, #090d16 100%);
        color: #f8fafc;
        padding: 4.5rem 1.5rem 3.5rem 1.5rem;
        overflow: hidden;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .ambient-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        pointer-events: none;
        z-index: 1;
        opacity: 0.4;
    }

    .glow-1 {
        width: 500px;
        height: 500px;
        top: -100px;
        left: 5%;
        background: radial-gradient(circle, #6366f1 0%, rgba(99, 102, 241, 0) 70%);
    }

    .glow-2 {
        width: 440px;
        height: 440px;
        bottom: -50px;
        right: 5%;
        background: radial-gradient(circle, #8b5cf6 0%, rgba(139, 92, 246, 0) 70%);
    }

    .grid-overlay {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        background-size: 40px 40px;
        mask-image: radial-gradient(circle at center, black 40%, transparent 85%);
        pointer-events: none;
        z-index: 1;
    }

    .hero-container {
        position: relative;
        z-index: 2;
        max-width: 1240px;
        margin: 0 auto;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        background: rgba(30, 41, 59, 0.7);
        border: 1px solid rgba(129, 140, 248, 0.35);
        border-radius: 9999px;
        padding: 0.4rem 1rem;
        font-size: 0.85rem;
        font-weight: 500;
        color: #e0e7ff;
