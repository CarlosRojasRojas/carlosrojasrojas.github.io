---
import Layout from '../layouts/Layout.astro';
import HeroNew from '../components/HeroNew.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import { siteConfig } from '../siteConfig';

import nbaClashGameplay from '../assets/Images/nba-clash-gameplay.jpeg';
import nbaClashGameplayTwo from '../assets/Images/nba-clash-gameplay-2.jpeg';
import royalDefendersBanner from '../assets/Images/royal-defenders-banner.jpg';
import royalDefendersGameplay from '../assets/Images/royal-defenders-gameplay.png';
import bloodBrothersGameplay from '../assets/Images/bb2-gameplay.jpeg';
import bloodBrothersIcon from '../assets/Images/bb2-icon.jpeg';
import starWarsGameplay from '../assets/Images/sw-galactic-defense-gameplay.jpeg';
import starWarsIcon from '../assets/Images/sw-galactic-defense-icon.jpg';
import tetrisSpaceInvaders from '../assets/Images/tetris-space-invaders.jpeg';
import tetrisXmasSeason from '../assets/Images/tetris-xmas-season.jpeg';

const pageTitle = 'Carlos Rojas Rojas | LiveOps Product Manager & Senior Tech Lead';

const featuredProjects = [
  {
    title: "Tetris® Mobile",
    role: "LiveOps Product Manager",
    company: "Playstudios Chile",
    tagline: "Live operations, content cadencing, and A/B test experiments for the iconic puzzle franchise.",
    metric: "ARPU Uplift",
    image: "/Images/TetrisIcon.jpeg",
    gameplay: tetrisSpaceInvaders.src,
    link: "/games#tetris-mobile",
    tags: ["LiveOps", "A/B Testing", "Economy Tuning", "Mobile Game"]
  },
  {
    title: "NBA Clash",
    role: "Senior Game Producer",
    company: "Globant",
    tagline: "Roadmap ownership, content planning, and conversion optimization for licensed sports action.",
    metric: "Full Roadmap Ownership",
    image: "/Images/nbaClashIcon.png",
    gameplay: nbaClashGameplay.src,
    link: "/games#nba-clash",
    tags: ["Sports Game", "Content Roadmap", "Player Retention"]
  },
  {
    title: "Star Wars™ Galactic Defense",
    role: "Game Analytics & Design Director",
    company: "DeNA Santiago",
    tagline: "Led 12-person analytics and game design team, establishing LiveOps studio capabilities.",
    metric: "12-Person Team Led",
    image: starWarsIcon.src,
    gameplay: starWarsGameplay.src,
    link: "/games#star-wars-galactic-defense",
    tags: ["Director", "BigQuery BI", "LiveOps Capabilities"]
  },
  {
    title: "AEW Figure Fighters",
    role: "Live Content Producer",
    company: "Globant",
    tagline: "Live content production, feature delivery, and moveset progression for a licensed collectible RPG.",
    metric: "Economy & Character Curves",
    image: "/Images/AEWFFLogo.jpg",
    gameplay: "/Images/AEWFF_gameplay.jpg",
    link: "/games#aew-figure-fighters",
    tags: ["Live Content", "Character Design", "Mobile RPG"]
  }
];

const pillars = [
  {
    icon: "🎯",
    title: "LiveOps & Monetization",
    description: "Architecting sustainable in-game economies, event cadence schedules, and conversion funnels that boost lifetime value without sacrificing player experience."
  },
  {
    icon: "📊",
    title: "Analytical Rigor & Data Science",
    description: "Designing rigorous A/B experiments, ETL pipelines, and BI dashboards with Google BigQuery, SQL, and Tableau to guide high-stakes product decisions."
  },
  {
    icon: "🚀",
    title: "High-Performance Leadership",
    description: "15+ years managing cross-functional squads of engineers, game designers, and analysts under Scrum, SAFe, and Agile to ship on time and on budget."
  }
];
---

<Layout title={pageTitle} currentPath="/new-index">

  <!-- Interactive Comparison Notice Header -->
  <aside class="preview-banner" aria-label="Version preview switcher">
    <div class="preview-inner">
      <div class="preview-badge">
        <span class="sparkle">✨</span>
        <strong>NEW HOMEPAGE DESIGN PREVIEW</strong>
      </div>
      <p class="preview-text">
        Modern executive presentation with enhanced hero banner, impact metrics, and portfolio showcase.
      </p>
      <div class="preview-actions">
        <a href="/" class="preview-link">Go to Live Home (/) &rarr;</a>
      </div>
    </div>
  </aside>

  <!-- Top Hero Banner -->
  <HeroNew />

  <!-- Strategic Pillars Section -->
  <section class="section pillars-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-tag">Core Value Proposition</span>
        <h2 class="section-heading">Strategic Expertise & Impact</h2>
        <p class="section-lead">
          Combining analytical engineering rigor with game product management to deliver measurable commercial results.
        </p>
      </div>

      <div class="pillars-grid">
        {pillars.map(pillar => (
          <div class="pillar-card">
            <div class="pillar-icon-box">{pillar.icon}</div>
            <h3 class="pillar-title">{pillar.title}</h3>
            <p class="pillar-desc">{pillar.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Portfolio Highlights Section -->
  <section class="section bg-card-section" id="featured-work">
    <div class="container">
      <div class="section-header-flex">
        <div>
          <span class="section-tag">Flagship Products</span>
          <h2 class="section-heading">Featured Portfolio Highlights</h2>
          <p class="section-lead">Selected commercial products and live operations projects.</p>
        </div>
        <a href="/games" class="see-all-link">
          <span>Explore More</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </div>

      <div class="featured-grid">
        {featuredProjects.map(project => (
          <div class="featured-card">
            <div class="featured-card-top">
              <div class="featured-header">
                <img src={project.image} alt={project.title} class="project-thumb" />
                <div class="project-meta">
                  <h3 class="project-title">{project.title}</h3>
                  <span class="project-company">{project.company} · {project.role}</span>
                </div>
              </div>
              <span class="metric-badge">{project.metric}</span>
            </div>

            <p class="project-tagline">{project.tagline}</p>

            {project.gameplay && (
              <div class="project-screenshot-box">
                <img src={project.gameplay} alt={`${project.title} gameplay preview`} class="project-screenshot" loading="lazy" />
              </div>
            )}

            <div class="project-footer">
              <div class="tag-list">
                {project.tags.map(tag => (
                  <span class="tag-pill">{tag}</span>
                ))}
              </div>
              <a href={project.link} class="card-action-link">
                View Details →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Comprehensive Work Experience Section -->
  <section class="section" id="experience">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Career Trajectory</span>
        <h2 class="section-heading">Detailed Work Experience</h2>
        <p class="section-lead">A progressive 15-year career across top gaming studios, financial institutions, and global advisory firms.</p>
      </div>

      <div class="experience-list">
        <ExperienceCard 
          title="LiveOps Product Manager"
          company="Playstudios Chile SPA"
          period="11/2024 - 03/2026"
          description="In charge of Live Operations team for the Tetris Mobile App product."
          highlights={[
            "Increased ARPU from 0.12 to 0.14 after content planning and cadencing improvements",
            "Performed analytical reports and A/B Testing Design for LiveOps features",
            "Created new feature proposals and tuned game economy balance",
            "Collaborated with Marketing to synchronize in-game events and social campaigns"
          ]}
          images={[
            { url: "/Images/TetrisIcon.jpeg", alt: "Tetris Mobile", link: "https://www.playstudios.com/tetris/" },
            { url: tetrisSpaceInvaders.src, alt: "Tetris Space Invaders Event", link: "/games#tetris-mobile" },
            { url: tetrisXmasSeason.src, alt: "Tetris Holiday Season Event", link: "/games#tetris-mobile" }
          ]}
        />

        <ExperienceCard 
          title="Senior Game Producer"
          company="Globant"
          period="07/2021 - 10/2024"
          description="In charge of Live Operations and Analytics for premier gaming projects."
          highlights={[
            "Owned content planning and delivery, plus Analytical Reporting for NBA Clash (2021-2022)",
            "Spearheaded content planning, feature proposals and economy design for LaLiga Land of Goals",
            "Directed content production and character move sets for AEW Figure Fighters"
          ]}
          images={[
            { url: "/Images/nbaClashIcon.png", alt: "NBA Clash", link: "https://www.youtube.com/watch?v=UFlPVdTDWwk" },
            { url: nbaClashGameplay.src, alt: "NBA Clash Gameplay", link: "/games#nba-clash" },
            { url: "/Images/LandOfGoalsIcon.jpeg", alt: "LaLiga Land of Goals", link: "/games#laliga-land-of-goals" },
            { url: "/Images/AEWFFLogo.jpg", alt: "AEW Figure Fighters", link: "/games#aew-figure-fighters" }
          ]}
        />

        <ExperienceCard 
          title="Project Manager"
          company="KPMG Auditores Consultores SPA"
          period="05/2019 - 06/2021"
          description="Manager of a software engineering team delivering mission-critical internal and client-facing analytical solutions."
          highlights={[
            "Delivered the KPMG Datax Tax Intelligence Platform",
            "Architected and deployed client portals conciliacionautos.cl and devolucionseguros.cl",
            "Managed multi-tenant cloud infrastructure and presented roadmap updates to C-level stakeholders",
            "Implemented Agile/Scrum delivery cadences across distributed squads"
          ]}
          images={[]}
        />

        <ExperienceCard 
          title="Senior Machine Learning Engineer"
          company="BCI Bank"
          period="06/2017 - 04/2019"
          description="Led data analytics, NLP, and AI research initiatives, including Data Lake ETL pipelines."
          highlights={[
            "Engineered the bank's first conversational AI financial chatbot",
            "Automated document and transaction parsing via custom extensions",
            "Created executive visualization suites for financial time-series data"
          ]}
          images={[]}
        />

        <ExperienceCard 
          title="Game Analytics & Design Director"
          company="DeNA Santiago"
          period="09/2014 - 10/2016"
          description="Led a multidisciplinary studio team of 12 game designers and data analysts."
          highlights={[
            "Automated enterprise BI telemetry using Google BigQuery",
            "Established foundational Live Operations infrastructure and best practices in Chile studio",
            "Held Board of Directors seat at DeNA Santiago Studio, shaping regional product strategy",
            "Shipped & supported major titles: Star Wars: Galactic Defense and Blood Brothers 2"
          ]}
          images={[
            { url: starWarsIcon.src, alt: "Star Wars Galactic Defense icon", link: "/games#star-wars-galactic-defense" },
            { url: starWarsGameplay.src, alt: "Star Wars Galactic Defense gameplay", link: "/games#star-wars-galactic-defense" },
            { url: bloodBrothersIcon.src, alt: "Blood Brothers 2 icon", link: "/games#blood-brothers-2" },
            { url: bloodBrothersGameplay.src, alt: "Blood Brothers 2 gameplay", link: "/games#blood-brothers-2" }
          ]}
        />

        <ExperienceCard 
          title="Senior Data Analyst"
          company="Atakama Labs / DeNA Santiago"
          period="08/2012 - 08/2014"
          description="In-depth quantitative analysis to maximize retention, monetization, and feature adoption."
          highlights={[
            "Identified gameplay economy bottlenecks and tuned sinks/faucets to drive revenue growth",
            "Delivered daily analytical briefings to design leads to optimize gameplay balance",
            "Supported live game events and content release updates"
          ]}
          images={[
            { url: royalDefendersBanner.src, alt: "Royal Defenders banner", link: "/games#royal-defenders" },
            { url: royalDefendersGameplay.src, alt: "Royal Defenders gameplay", link: "/games#royal-defenders" }
          ]}
        />
      </div>
    </div>
  </section>

  <!-- Technical Stack & Skills Matrix -->
  <section class="section bg-light-section" id="skills">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-tag">Competencies</span>
        <h2 class="section-heading">Skills & Technology Matrix</h2>
        <p class="section-lead">A balanced combination of engineering acumen, data analytics, and product execution.</p>
      </div>

      <div class="skills-matrix">
        
        <div class="skill-category">
          <div class="skill-cat-header">
            <span class="cat-icon">🎮</span>
            <h3>Product & LiveOps</h3>
          </div>
          <div class="skill-tags">
            <span class="tag">LiveOps Planning</span>
            <span class="tag">Game Economy Design</span>
            <span class="tag">A/B Testing</span>
            <span class="tag">ARPDAU / ARPU Growth</span>
            <span class="tag">Content Cadencing</span>
            <span class="tag">Player Retention Funnels</span>
          </div>
        </div>

        <div class="skill-category">
          <div class="skill-cat-header">
            <span class="cat-icon">📊</span>
            <h3>Data & Analytics</h3>
          </div>
          <div class="skill-tags">
            <span class="tag">Google BigQuery</span>
            <span class="tag">Tableau Desktop & Server</span>
            <span class="tag">Python (Pandas, NumPy)</span>
            <span class="tag">R Statistical Computing</span>
            <span class="tag">Hadoop / Spark</span>
            <span class="tag">ETL & Data Lake Pipelines</span>
          </div>
        </div>

        <div class="skill-category">
          <div class="skill-cat-header">
            <span class="cat-icon">💾</span>
            <h3>Databases</h3>
          </div>
          <div class="skill-tags">
            <span class="tag">SQL Server</span>
            <span class="tag">PostgreSQL</span>
            <span class="tag">Oracle</span>
            <span class="tag">MongoDB</span>
            <span class="tag">DocumentDB</span>
            <span class="tag">HBase</span>
          </div>
        </div>

        <div class="skill-category">
          <div class="skill-cat-header">
            <span class="cat-icon">💻</span>
            <h3>Engineering & Web</h3>
          </div>
          <div class="skill-tags">
            <span class="tag">C# / .NET</span>
            <span class="tag">Node.js / Express</span>
            <span class="tag">React</span>
            <span class="tag">Angular</span>
            <span class="tag">Django & REST</span>
            <span class="tag">Docker & CI/CD</span>
          </div>
        </div>

        <div class="skill-category">
          <div class="skill-cat-header">
            <span class="cat-icon">🤝</span>
            <h3>Leadership & Agile</h3>
          </div>
          <div class="skill-tags">
            <span class="tag">Scrum Master / Agile</span>
            <span class="tag">SAFe Framework</span>
            <span class="tag">Cross-functional Squads</span>
            <span class="tag">C-Level Stakeholder Management</span>
            <span class="tag">Roadmap Governance</span>
            <span class="tag">Hiring & Mentorship</span>
          </div>
        </div>

        <div class="skill-category">
          <div class="skill-cat-header">
            <span class="cat-icon">📜</span>
            <h3>Certifications & Cloud</h3>
          </div>
          <div class="skill-tags">
            <span class="tag highlight-cert">Azure AZ900 Certified</span>
            <span class="tag highlight-cert">GCP Digital Leader</span>
            <span class="tag">AWS Cloud Fundamentals</span>
            <span class="tag">Git / SVN</span>
            <span class="tag">English C2 (TOEIC 840)</span>
            <span class="tag">Spanish (Native)</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Education & Academic Distinction Spotlight -->
  <section class="section education-section">
    <div class="container">
      <div class="education-card">
        <div class="edu-icon-col">
          <div class="edu-seal">PUC</div>
        </div>
        <div class="edu-content-col">
          <span class="edu-badge">Academic Foundation</span>
          <h3 class="edu-degree">{siteConfig.education.degree}</h3>
          <p class="edu-school">{siteConfig.education.university} · Graduated {siteConfig.education.year}</p>
          <div class="edu-honors">
            <span class="trophy-icon">🏆</span>
            <p><strong>Distinction:</strong> {siteConfig.education.honors}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA & Contact Strip -->
  <section class="section cta-strip-section">
    <div class="container">
      <div class="cta-banner-glass">
        <div class="cta-content">
          <h2 class="cta-title">Interested in collaborating or discussing opportunities?</h2>
          <p class="cta-desc">
            Whether you need a seasoned LiveOps leader to grow your game economy or a technical Project Manager for data products, let's talk.
          </p>
        </div>
        <div class="cta-buttons">
          <a href={`mailto:${siteConfig.email}`} class="cta-primary-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>Send Email</span>
          </a>
          <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="cta-secondary-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64c-.95 0-1.68.74-1.68 1.69a1.69 1.69 0 0 0 1.68 1.69c.96 0 1.69-.75 1.69-1.69 0-.95-.73-1.69-1.69-1.69Z"/>
            </svg>
            <span>Connect on LinkedIn</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  :global(body) {
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    color: #1e293b;
    background-color: #f8fafc;
  }

  /* Comparison Preview Notice Banner */
  .preview-banner {
    background: linear-gradient(90deg, #1e1b4b 0%, #312e81 100%);
    color: #e0e7ff;
    padding: 0.65rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .preview-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
  }

  .preview-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(99, 102, 241, 0.35);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    letter-spacing: 0.04em;
    font-size: 0.78rem;
    color: #c7d2fe;
    border: 1px solid rgba(165, 180, 252, 0.3);
  }

  .preview-text {
    color: #cbd5e1;
    margin: 0;
  }

  .preview-link {
    display: inline-flex;
    align-items: center;
    color: #ffffff;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s;
  }

  .preview-link:hover {
    color: #93c5fd;
  }

  /* Section Standard Layouts */
  .section {
    padding: 4.5rem 1.5rem;
  }

  .container {
    max-width: 1240px;
    margin: 0 auto;
  }

  .bg-card-section {
    background-color: #f1f5f9;
  }

  .bg-light-section {
    background-color: #ffffff;
  }

  /* Section Headers */
  .section-header {
    margin-bottom: 3rem;
  }

  .section-header.text-center {
    text-align: center;
  }

  .section-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.5rem;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .section-tag {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: #4f46e5;
    background: rgba(79, 70, 229, 0.08);
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }

  .section-heading {
    font-family: 'Outfit', sans-serif;
    font-size: 2.4rem;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .section-lead {
    font-size: 1.05rem;
    color: #64748b;
    max-width: 680px;
    line-height: 1.6;
    margin: 0;
  }

  .section-header.text-center .section-lead {
    margin: 0 auto;
  }

  .see-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: #4f46e5;
    text-decoration: none;
    transition: transform 0.2s;
  }

  .see-all-link:hover {
    transform: translateX(4px);
    text-decoration: none;
    color: #4338ca;
  }

  /* Strategic Pillars Grid */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 2rem;
  }

  .pillar-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 2.25rem 1.75rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .pillar-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(79, 70, 229, 0.08);
    border-color: #cbd5e1;
  }

  .pillar-icon-box {
    font-size: 2.2rem;
    margin-bottom: 1.25rem;
    display: inline-block;
  }

  .pillar-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.75rem;
  }

  .pillar-desc {
    font-size: 0.95rem;
    line-height: 1.65;
    color: #475569;
    margin: 0;
  }

  /* Featured Highlights Grid */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .featured-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.04);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .featured-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.08);
  }

  .featured-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .featured-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .project-thumb {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  }

  .project-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.25rem;
