---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  author?: string;
  tags?: string[];
}

const { title, description, pubDate, slug, author, tags } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="blog-card">
  <div class="card-content">
    <div class="card-meta">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      {author && <span class="author">by {author}</span>}
    </div>
    <h2 class="card-title">{title}</h2>
    <p class="card-description">{description}</p>
    {tags && tags.length > 0 && (
      <div class="tags">
        {tags.map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}
    <a href={`/blog/${slug}`} class="read-more">Read More →</a>
  </div>
</article>

<style>
  .blog-card {
    background: white;
    border-radius: 8px;
    padding: 1.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s, box-shadow 0.3s;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.875rem;
    color: #6b7280;
    margin-bottom: 0.75rem;
  }

  .author {
    color: #667eea;
    font-weight: 600;
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: bold;
    color: #1f2937;
    margin: 0.5rem 0 1rem 0;
    line-height: 1.4;
  }

  .card-description {
    color: #4b5563;
    line-height: 1.6;
    flex: 1;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .tag {
    background-color: #e0e7ff;
    color: #667eea;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .read-more {
    color: #667eea;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s;
    align-self: start;
  }

  .read-more:hover {
    color: #764ba2;
  }
</style>
