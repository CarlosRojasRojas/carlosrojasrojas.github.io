---
import Navigation from '../components/Navigation.astro';

interface Props {
	title?: string;
	currentPath?: string;
}

const { title = 'Portfolio', currentPath } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<Navigation currentPath={currentPath} />
		<main>
			<slot />
		</main>
		<footer>
			<p>&copy; 2026 Carlos Rojas Portfolio. All rights reserved.</p>
		</footer>
	</body>
</html>

<style is:global>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html,
	body {
		font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
		background-color: #f9fafb;
		color: #1f2937;
		line-height: 1.6;
	}

	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	main {
		flex: 1;
		width: 100%;
	}

	footer {
		background-color: #1f2937;
		color: #d1d5db;
		text-align: center;
		padding: 2rem;
		margin-top: 4rem;
	}

	a {
		color: #667eea;
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
	}

	h1, h2, h3, h4, h5, h6 {
		line-height: 1.2;
	}

	@media (max-width: 768px) {
		body {
			font-size: 0.95rem;
		}
	}
</style>
